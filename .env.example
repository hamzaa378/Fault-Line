# Copy to .env for local Docker Compose. Replace these before any public deployment.
POSTGRES_PASSWORD=faultline-local-demo-only
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE_FOR_ANY_REAL_DEPLOYMENT
SEED_PASSWORD=DemoPassword123!
# Required only for GitHub signed webhook ingress
GITHUB_WEBHOOK_SECRET=
# Recommended for webhook testing and required for safer externally exposed use:
# Bind this receiver to the actual Orbit Commerce project UUID.
GITHUB_PROJECT_ID=
# Comma-separated owner/repository list, e.g. yourname/faultline-demo
GITHUB_ALLOWED_REPOSITORIES=
# Identifies which service incoming commits belong to (never inferred from file names).
GITHUB_DEFAULT_SERVICE=checkout-api
